# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=production
FLASK_DEBUG=False

# Application Settings
APP_NAME=Sales Buddy

# Server port (used by deploy scripts)
# Using 5151 to avoid conflicts with Flask's default 5000
PORT=5151

# Single-User Local Deployment
# No authentication required - app runs in single-user mode

# AI Features (optional)
# AI calls go through the APIM gateway automatically - no env vars needed.
# Just log in with 'az login' using a Microsoft (@microsoft.com) account.

# Development calendar testing (ignored unless FLASK_ENV=development)
# Force Activity Coverage imports through parallel WorkIQ instead of the
# automatic Outlook-first path. When already current, the import button reruns
# the latest five weekdays so all five workers can be tested repeatedly.
# SALESBUDDY_CALENDAR_SOURCE=workiq

# Scheduled Milestone Sync (optional)
# Set to an hour (0-23) to auto-sync milestones daily at that time
# Example: MILESTONE_SYNC_HOUR=3  (syncs at 3:00 AM)
# MILESTONE_SYNC_HOUR=
